+def _stamp_grid_brier():
+    """One-time backfill: copy the KILL_BRIER_TAU grid score from
+    scored_windows*.jsonl into brier_windows entries that lack it.
+
+    Same labels as the entries (both written by the same scorer). Windows
+    without that grid point stay unstamped -- never estimated. Safety as
+    _stamp_legacy_model_v: refuses on a kill_check_error flag or a held tick
+    lock; backs up STATE first; idempotent (second run stamps 0).
+    Returns the stamped count. Raises SystemExit on refusal.
+    """
+    flag = _kc_flag_read()
+    if flag is not None:
+        print(f"REFUSED: kill_check_error flag set "
+              f"({flag.get('type')}: {flag.get('message')}) -- clear it first")
+        raise SystemExit(1)
+    if _tick_lock_held():
+        print("REFUSED: tick lock held -- run between ticks")
+        raise SystemExit(1)
+    raw = _kc_load_raw()
+    if raw is None:
+        print("REFUSED: STATE unreadable")
+        raise SystemExit(1)
+    by_t = {r["T"]: r for r in _read_scored_windows()}
+    ts = int(time.time())
+    bak = f"{STATE}.pre_grid_stamp.{ts}"
+    shutil.copy2(STATE, bak)
+    n = 0
+    for w in raw.get("brier_windows", []):
+        if w.get("g_tau") == KILL_BRIER_TAU:
+            continue
+        g = ((by_t.get(w.get("T")) or {}).get("tau_grid_scores") or {}) \
+            .get(str(KILL_BRIER_TAU))
+        if not g:
+            continue
+        bm, bk = g.get("brier_model"), g.get("brier_mkt")
+        if not all(isinstance(x, (int, float)) and not isinstance(x, bool)
+                   and math.isfinite(x) for x in (bm, bk)):
+            continue
+        w["g_tau"] = KILL_BRIER_TAU
+        w["g_brier_model"] = bm
+        w["g_brier_mkt"] = bk
+        w["g_tau_actual"] = g.get("tau_actual")
+        w["g_stamped_from"] = "scored_windows"
+        n += 1
+    _atomic_json_write(STATE, raw)
+    with open(STATE + ".model_v_audit.log", "a") as f:
+        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} "
+                f"grid_brier_stamped={n} tau={KILL_BRIER_TAU} "
+                f"source=scored_windows backup={bak}\n")
+    print(f"stamped {n} windows with tau={KILL_BRIER_TAU} grid Brier "
+          f"(backup: {bak})")
+    return n
+
