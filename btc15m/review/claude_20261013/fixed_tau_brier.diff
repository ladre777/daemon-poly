+def _brier_grid_diffs(state):
+    """Paired (model - market) Brier at the fixed grid point KILL_BRIER_TAU.
+
+    Same window set as _brier_windows_current (current model version, one
+    record per window), restricted to windows that carry a grid score at
+    KILL_BRIER_TAU (stamped at scoring time, or backfilled once by
+    --stamp-grid-brier). Malformed values are skipped, never coerced.
+    One helper for kill(c), gate [3] and the report.
+    """
+    out = []
+    for w in _brier_windows_current(state):
+        if w.get("g_tau") != KILL_BRIER_TAU:
+            continue
+        bm, bk = w.get("g_brier_model"), w.get("g_brier_mkt")
+        if isinstance(bm, bool) or isinstance(bk, bool):
+            continue
+        if not isinstance(bm, (int, float)) or not isinstance(bk, (int, float)):
+            continue
+        if not (math.isfinite(bm) and math.isfinite(bk)):
+            continue
+        out.append(bm - bk)
+    return out
+
