# =============================================================================
# DÆMON-KALSHI — production-oriented env template (2026-08-21)
# Copy to Railway dashboard vars. Never commit real secrets.
# Full checklist: docs/PRODUCTION.md
# =============================================================================

# -- Kalshi -----------------------------------------------------------------
KALSHI_ENV=demo                    # demo until paper funnel shows approvals
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
KALSHI_PRIVATE_KEY_PEM=

# -- Models -----------------------------------------------------------------
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2-turbo-preview
ANTHROPIC_API_KEY=

# Checker (default Moonshot — stops Claude token burn)
CHECKER_LLM_PROVIDER=moonshot      # moonshot | anthropic | auto
CHECKER_MODEL=kimi-k2-turbo-preview
CHECKER_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Maker
MAKER_LLM_PROVIDER=auto
MAKER_FALLBACK_MODEL=claude-haiku-4-5-20251001

# Grounding
FRED_API_KEY=
SLASH_GOLF_API_KEY=                 # RapidAPI Live Golf Data — wired in main.py

# -- Risk -------------------------------------------------------------------
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.10
COUNT_UNREALIZED_GAINS=false
MAX_OPEN_POSITIONS=15
MAX_TOTAL_EXPOSURE_PCT=0.50
MAX_TICKER_EXPOSURE_PCT=0.05
MAX_EVENT_EXPOSURE_PCT=0.10
MAX_CATEGORY_EXPOSURE_PCT=0.25
FEE_RATE=0.07
SLIPPAGE_CENTS=1.0
MAX_RECONCILIATION_AGE_SECONDS=90
DEDUPE_WINDOW_SECONDS=3600
ORDER_TTL_SECONDS=300
ALLOW_POSITION_DRIFT=false
MIN_EDGE_THRESHOLD=0.04
MIN_LIQUIDITY_USD=500
CHECKER_MIN_CONFIDENCE=0.65
DRY_RUN=true                       # paper until calibration is healthy
LONGSHOT_PRICE_THRESHOLD_CENTS=20
LONGSHOT_EDGE_MULTIPLIER=1.5
ORDER_STRATEGY=taker               # maker blocked until order lifecycle exists

KELLY_ENABLED=true
KELLY_FRACTION=0.25

# -- Quant / crypto ---------------------------------------------------------
MAX_SPOT_AGE_SECONDS=120
SPOT_OUTLIER_RATIO=1.5
MIN_VOL_OBSERVATIONS=10
MIN_VOL_SPAN_SECONDS=600
QUANT_ALLOW_UNVERIFIED=false
CRYPTO_SETTLEMENT_BLACKOUT_SECONDS=90
RTI_FEED_ENABLED=true
PERSIST_VOL_HISTORY=true
VOL_HISTORY_RETENTION_SECONDS=14400
MAX_VOL_SPIKE_RATIO=1.75           # refuse pricing after sharp realized-vol spikes
MAX_HORIZON_VOL_SPAN_RATIO=4.0
SKIP_MULTI_EVENT_SHARDS=true
SCOUT_SPORTS_CATEGORIES=Golf

# -- Arb (detection only — does not place orders) ---------------------------
ARB_ENABLED=true
ARB_MIN_PROFIT_CENTS=1.0
ARB_MAX_PAIRS=100

# -- Scout ------------------------------------------------------------------
SCOUT_CATEGORIES=Sports,Crypto,Weather
LLM_REASONING_CATEGORIES=sports,weather
PRIORITY_KEYWORDS=golf,pga,btc,bitcoin,eth,high,temperature
PRIORITY_CATEGORIES=weather,crypto
MAX_LLM_CALLS_PER_PASS=40
MAX_LLM_CALLS_PER_EVENT=2
MAX_FALLBACK_LLM_CALLS_PER_PASS=10
MODEL_FAILURE_THRESHOLD=5
SCOUT_POLL_SECONDS=180

# -- Telegram (optional) ----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_TRADES=true
TELEGRAM_STALL_ALERT_SECONDS=900
TELEGRAM_DAILY_SUMMARY_HOUR_UTC=-1

# -- Storage ----------------------------------------------------------------
# Requires Railway Volume mounted at /data or history resets every redeploy.
LEDGER_DB_PATH=/data/daemon_kalshi.db
LOG_LEVEL=INFO
