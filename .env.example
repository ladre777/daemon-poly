# Kalshi
KALSHI_ENV=demo                    # "demo" or "prod" — start on demo
KALSHI_API_KEY_ID=
# Local dev: point at a file. On Railway: paste the PEM contents directly
# into KALSHI_PRIVATE_KEY_PEM instead (no persistent filesystem to mount a
# file into) and leave KALSHI_PRIVATE_KEY_PATH blank.
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
KALSHI_PRIVATE_KEY_PEM=

# Models
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2-turbo-preview
ANTHROPIC_API_KEY=
CHECKER_MODEL=claude-sonnet-5

# Which backend answers Maker calls.
#   auto      (default) Moonshot, failing over to Anthropic when Moonshot is
#             unreachable, unauthorised, or has no usable model for the key
#   moonshot  pin Moonshot, no failover
#   anthropic pin Anthropic, no failover
MAKER_LLM_PROVIDER=auto
# Model used while on the Anthropic fallback. Kept cheap on purpose: the Maker
# runs tens of calls per pass, so the Checker's model would be costly here.
MAKER_FALLBACK_MODEL=claude-haiku-4-5-20251001
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html — leave
# blank to just skip economics-category grounding, nothing else breaks.
FRED_API_KEY=

# Risk
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.10
MAX_OPEN_POSITIONS=15
# Worst-case dollar exposure caps, as a fraction of the effective bankroll
# (the lesser of --bankroll and the real exchange balance). A count of open
# positions says nothing about money at risk — these are the limits risk
# actually enforces. See docs/SAFETY.md for the exact formulas.
MAX_TOTAL_EXPOSURE_PCT=0.50
MAX_TICKER_EXPOSURE_PCT=0.05
# Markets inside one event are usually mutually exclusive outcomes of the
# same question, so several positions there are one correlated bet.
MAX_EVENT_EXPOSURE_PCT=0.10
MAX_CATEGORY_EXPOSURE_PCT=0.25
# Kalshi's taker fee is roughly FEE_RATE * price * (1 - price) per contract.
# Charged into sizing up front so a trade thinner than its fees is refused.
FEE_RATE=0.07
SLIPPAGE_CENTS=1.0
# Account state older than this is not trusted for trading — the bot fails
# closed rather than sizing against a stale picture.
MAX_RECONCILIATION_AGE_SECONDS=90
# One order per identical intent (ticker/side/price/size) per window. Stops
# the 30-second scan loop stacking orders on a signal that persists.
DEDUPE_WINDOW_SECONDS=3600
# TTL for resting orders. Unused while maker mode is refused.
ORDER_TTL_SECONDS=300
# Set true ONLY for a first run against an account that already holds
# manually opened positions, where local fill history can't match the
# exchange. Logs the drift loudly instead of blocking startup. Leave false
# in production: drift normally means the fill record is wrong.
ALLOW_POSITION_DRIFT=false
MIN_EDGE_THRESHOLD=0.04
MIN_LIQUIDITY_USD=500
CHECKER_MIN_CONFIDENCE=0.65
DRY_RUN=true
# Longshot bias guard — see risk_guardrail.py. Sourced from Becker's 72.1M-
# trade Kalshi analysis (jbecker.dev/research/prediction-market-microstructure).
LONGSHOT_PRICE_THRESHOLD_CENTS=20
LONGSHOT_EDGE_MULTIPLIER=1.5
# "taker" (IOC, fills now) or "maker" (GTC, doesn't cross spread — see
# execution.py's docstring, this isn't a complete order-lifecycle solution yet)
ORDER_STRATEGY=taker

# -- Data validation (P1 item 6) ---------------------------------------
# A quote older than this is not tradeable. Enforced twice: Scout refuses to
# build a candidate from a stale quote, and risk re-checks the quote captured
# at decision time immediately before submission, so a proposal that sat in
# the LLM queue is rejected rather than acted on at a price that has moved.
MAX_QUOTE_AGE_SECONDS=60
# Bounds on free text from models and feeds — it lands in the database, in
# the next prompt as playbook context, and in log lines.
MAX_REASONING_CHARS=2000
MAX_PLAYBOOK_CHARS=4000
MAX_CONTEXT_CHARS=4000
MAX_TITLE_CHARS=300

# -- Quant path data quality (P1 item 8) -------------------------------
MAX_SPOT_AGE_SECONDS=120
# A print this far from the recent median is treated as a feed glitch.
# Volatility is in the denominator of the quant probability, so one bad tick
# distorts every market on that symbol while it stays in the window.
SPOT_OUTLIER_RATIO=1.5
MIN_VOL_OBSERVATIONS=10
MIN_VOL_SPAN_SECONDS=600
SPOT_BACKOFF_BASE_SECONDS=30
SPOT_BACKOFF_MAX_SECONDS=900
# Every contract spec in core/contract_specs.py ships verified=False, because
# none has been checked against Kalshi's own settlement rules (which index,
# which observation window, which units). The quant path declines them by
# default. Set true to price them anyway — demo experimentation only.
QUANT_ALLOW_UNVERIFIED=false

# Scout — taxonomy group names from core/kalshi_categories.py, ported from
# Becker's 72.1M-trade analysis. Valid groups: Sports, Politics, Crypto,
# Finance, Weather, Entertainment, Science/Tech, Media, World Events,
# Esports, Other. A name that matches no group is logged as an error at
# startup — the previous default guessed "Economics", "Climate" and
# "Culture", none of which exist, and a wrong name silently drops that whole
# vertical rather than erroring.
SCOUT_CATEGORIES=Sports,Crypto,Politics,Finance,Weather
# Groups the LLM Maker will reason on with no live spot feed — only where
# real grounding exists (ESPN/NOAA/FRED) or genuine qualitative reasoning is
# the point. Add groups here deliberately, as you wire real data for each.
LLM_REASONING_CATEGORIES=sports,politics,finance,weather
# Golf always gets processed first and is exempt from the LLM call cap below.
PRIORITY_KEYWORDS=golf,pga
# Caps Kimi calls per scan pass so a growing category list can't crowd out
# priority markets on cost/rate-limit budget. 0 = unlimited.
MAX_LLM_CALLS_PER_PASS=40
# Tighter cap that applies only while the Maker is on its fallback provider.
MAX_FALLBACK_LLM_CALLS_PER_PASS=10
# Consecutive Maker/Checker failures that end a pass. Below this, a failed
# model call skips one candidate; at it, the provider is presumed down.
MODEL_FAILURE_THRESHOLD=5
SCOUT_POLL_SECONDS=30

# -- Telegram alerting (optional) --------------------------------------
# Leave both blank and alerting disables itself — the bot runs exactly as
# before, silently. Setup:
#   1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#      It replies with a token shaped like 123456789:AAE...
#   2. Send your new bot a message (any message). A bot cannot start a
#      conversation with you, so without this step sends fail with
#      403 "bot can't initiate conversation with a user".
#   3. Get your chat ID: message @userinfobot, or open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and read
#      result[0].message.chat.id
#   4. Verify: python -m core.telegram_client
# For a group chat, add the bot to the group and use the group's ID
# (negative number, e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alerting is fire-and-forget: a Telegram outage logs a warning and drops
# the message, and can never raise into the trading loop.
TELEGRAM_TIMEOUT_SECONDS=10
# Bounded queue — alerts are dropped rather than buffered without limit,
# because unbounded buffering in a long-lived process is a memory leak.
TELEGRAM_QUEUE_MAXSIZE=200
# Telegram allows roughly one message per second to a given chat.
TELEGRAM_MIN_INTERVAL_SECONDS=1
TELEGRAM_MAX_BACKOFF_SECONDS=30
# Suppression window for repeating conditions, so reconciliation failing
# every 30s sends one alert per window instead of 120 an hour.
TELEGRAM_THROTTLE_SECONDS=900
TELEGRAM_KILL_SWITCH_THROTTLE_SECONDS=21600
TELEGRAM_STALL_THROTTLE_SECONDS=1800
TELEGRAM_FLUSH_TIMEOUT_SECONDS=5
# One alert per order that reaches the exchange. Set false if too noisy;
# the kill switch and systemic errors still alert either way.
TELEGRAM_NOTIFY_TRADES=true
# Watchdog: alert when no scan or reconciliation has succeeded in this many
# seconds. A bot that has quietly stopped trading looks exactly like a bot
# finding no edges — this is what tells them apart. 0 disables.
TELEGRAM_STALL_ALERT_SECONDS=900
# Hour (UTC, 0-23) for the daily summary. -1 disables it.
TELEGRAM_DAILY_SUMMARY_HOUR_UTC=-1

# Misc
# /data assumes a Railway Volume mounted at /data — see README for the
# one-time setup step. Without it, this file lives on ephemeral storage and
# gets wiped on every redeploy, silently resetting all edge memory.
LEDGER_DB_PATH=/data/daemon_kalshi.db
LOG_LEVEL=INFO
