# Build for the DÆMON-KALSHI service.
#
# A Dockerfile rather than an autodetected builder, deliberately. Build
# autodetection inspects the tree and guesses, and the guess is not stable
# across builder versions — a deploy that works today can pick a different
# phase or start command after an upstream change nobody here made. This is
# the build that was proven working on the live Railway service.
#
# This file removes the guessing. One base image, one dependency file, one
# start command, all explicit, and it is the single source of truth for how
# this service builds: railway.toml points at it rather than declaring a
# builder of its own.
#
# Railway builds with a Dockerfile whenever it finds one. railway.toml also
# names this file explicitly via build.dockerfilePath, so the non-standard
# filename is honoured without needing RAILWAY_DOCKERFILE_PATH set on the
# service. Setting that variable as well is harmless and still works.
FROM python:3.11-slim

# Fail fast and log immediately: without PYTHONUNBUFFERED, output sits in a
# buffer and a crash loop shows an empty log, which is the worst possible
# thing to debug a trading bot with.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Dependencies first so they cache independently of source changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Only what the daemon actually needs at runtime. tests/, backtest/ and
# docs/ are deliberately absent: verified by AST walk, nothing reachable
# from main.py imports them, so they are build context rather than runtime.
COPY main.py config.py ./
COPY core/ ./core/
COPY workers/ ./workers/
COPY memory/ ./memory/
# scripts/ IS reachable from main.py — ledger_answers runs once at startup.
# Omitting it does not fail the build; it fails the import at boot, which on a
# restart-on-failure policy is a crash loop rather than a visible error.
#
# Named files rather than the directory, to keep the rule above true: the rest
# of scripts/ is operator tooling that nothing at runtime imports.
COPY scripts/__init__.py scripts/ledger_answers.py ./scripts/

# Default location for the SQLite ledger. Attach a Railway Volume mounted at
# /data, or the database is ephemeral and every redeploy wipes order, fill
# and settlement history along with the kill-switch state. main.py refuses to
# start in prod without durable storage; see docs/SAFETY.md.
#
# Deliberately no `VOLUME ["/data"]` instruction: Railway rejects the build
# outright with "docker VOLUME at Line N is not supported, use Railway
# Volumes". Persistence is attached to the service, not declared in the image.
ENV LEDGER_DB_PATH=/data/daemon_kalshi.db

CMD ["python", "main.py"]
